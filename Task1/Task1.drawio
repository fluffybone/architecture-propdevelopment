        <mxCell id="IlKCfItSMnB-lSdsRJ27-26" value="&lt;div align=&quot;left&quot;&gt;&lt;span style=&quot;background-color: rgb(185, 224, 165);&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Утечка данных&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 14px; background-color: rgb(185, 224, 165);&quot;&gt;Потеря данных&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 14px; background-color: rgb(185, 224, 165);&quot;&gt;Некачественные данные&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px; background-color: rgb(255, 242, 204);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px; background-color: rgb(255, 181, 112);&quot;&gt;риск:Значительный&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;" vertex="1" parent="1">
